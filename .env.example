# Copiar a .env.local y rellenar (no subir secretos al repositorio).

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Flow (en pausa). Para reactivar: FLOW_PAYMENTS_ENABLED=true y las keys.
FLOW_API_KEY=
FLOW_SECRET_KEY=
# FLOW_API_URL=https://www.flow.cl/api
# FLOW_PAYMENTS_ENABLED=true

# Emails (separados por coma) con panel de noticias, imágenes y métricas.
# Deben coincidir con cms_allowlist en Supabase. El resto de usuarios solo entra al sitio.
CONTENT_EDITOR_EMAILS=stephanie@tu-dominio.cl

# Opcional: GA4 (marketing).
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXX
